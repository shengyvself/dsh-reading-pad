{
  "name": "dsh-reading-pad",
  "version": "0.1.0",
  "description": "Immersive read-only reading panel for DSH: the model delivers pre-formatted Markdown to a native right-sidebar tab, or you browse manuscript chapters read-only. Three low-blue-light themes, 30em measure, progress bar, scroll persistence.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "reading",
    "reading-pad",
    "reader",
    "markdown",
    "typography",
    "sidebar",
    "right-sidebar",
    "chapter",
    "manuscript"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shengyvself/dsh-reading-pad.git"
  },
  "license": "Apache-2.0"
}
